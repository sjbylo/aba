# Cluster Makefile  # DO NOT remove this line!

ifndef DEBUG_ABA
.SILENT:
MAKEFLAGS += --no-print-directory
endif

TEMPLATES = ../templates
SCRIPTS   = ../scripts

arch   := $(strip $(shell uname -m))

#debug = $(strip $(shell printf "%s" "$$DEBUG_ABA"))

-include ../aba.conf
platform := $(strip $(shell echo $(platform)))
ocp_version := $(strip $(shell echo $(ocp_version)))

# Unified install dependency chain for all platforms (bm / vmw / kvm).
# BM asks (edit + boot) live in bm-ask-*.sh; VM stamps no-op when platform=bm.
# Stamp names describe intent; user commands (upload/refresh/…) stay the same.
ifeq ($(platform),vmw)
	HV_PREFIX = vmw
	hv_conf_dep = vmware.conf
else ifeq ($(platform),kvm)
	HV_PREFIX = kvm
	hv_conf_dep = kvm.conf
else
	# bare-metal: no hypervisor scripts
	HV_PREFIX =
	hv_conf_dep =
endif

TARGET_DEPENDENCIES = check ../aba.conf iso .vms-stopped .iso-uploaded .vms-ready .bm-bmc-boot-done .install-complete
BOOTSTRAP_PRE_DEPS = check ../aba.conf iso .vms-stopped .iso-uploaded .vms-ready .bm-bmc-boot-done

.PHONY: install
install: _progress_plan-cluster-install $(TARGET_DEPENDENCIES) ## Install the cluster (generate ISO, boot VMs/servers, monitor)

.PHONY: _progress_plan-cluster-install
_progress_plan-cluster-install:
	@$(SCRIPTS)/progress-plan.sh cluster-install

# Check cluster has been installed already and abort if it has
.PHONY: check
check: init
	$(SCRIPTS)/check-cluster-installed.sh
ifdef HV_PREFIX
	@$(SCRIPTS)/check-vm-state.sh
endif

##@ Help-related tasks
.PHONY: help
help: ## Help
	@cat ../others/help-cluster.txt

# aba.conf should never be missing!
../aba.conf:
	@echo [ABA] "aba/aba.conf file missing! Please read the README.md on how to get started!"
	@exit 1

init: .init
.init:
	@ln -fs $(TEMPLATES)
	@ln -fs $(SCRIPTS)
	@ln -fs ../cli
	@_is=$$(grep '^image_source=' cluster.conf 2>/dev/null | cut -d= -f2 | sed 's/\#.*//' | awk '{print $$1}'); \
	 _is=$${_is:-mirror}; \
	 if [ "$$_is" != "direct" ] && [ "$$_is" != "proxy" ]; then \
	   ln -sfn ../$$_is mirror; \
	   [ -d ~/.aba/mirror/$$_is ] && ln -sfn ~/.aba/mirror/$$_is regcreds || rm -f regcreds; \
	 fi
	@if [ -f mirror/mirror.conf ]; then ln -fs mirror/mirror.conf; \
	else rm -f mirror.conf && touch mirror.conf; fi
	@ln -fs ../aba.conf
	@touch .init
	@echo [ABA] Initialized cluster directory `pwd` successfully

.cli: .init
	@$(SCRIPTS)/cli-install-all.sh --wait
	@touch .cli

mirror.conf:
	@if [ -f mirror/mirror.conf ]; then ln -fs mirror/mirror.conf; \
	else rm -f mirror.conf && touch mirror.conf; fi

vmware.conf: .init ## Use VMware vCenter or ESXi to create cluster.
	@cd .. && bash -c 'source scripts/include_all.sh && ensure_vmware_conf "$(CURDIR)"'

kvm.conf: .init ## Use KVM/libvirt to create cluster.
	@make -sC .. kvm
	@[ -f ../kvm.conf ] && [ ! -f kvm.conf ] && ln -s ../kvm.conf && echo [ABA] kvm.conf initialized || true

# Order-only prereqs (after |): .cli, .init, and mirror.conf on cluster.conf are build-order
# deps only — their timestamps must NOT trigger rebuilds of downstream targets.
# .cli/.init are setup markers; cluster.conf doesn't read mirror.conf.
cluster.conf: | .init mirror.conf  ## Initialize the OpenShift cluster.conf file.
	$(SCRIPTS)/create-cluster-conf.sh name=$(name) type=$(type) starting_ip=$(starting_ip) image_source=$(image_source) num_masters=$(num_masters) num_workers=$(num_workers) master_cpu_count=$(master_cpu_count) master_mem=$(master_mem) worker_cpu_count=$(worker_cpu_count) worker_mem=$(worker_mem) data_disk=$(data_disk) api_vip=$(api_vip) ingress_vip=$(ingress_vip) ports=$(ports) vlan=$(vlan) mac_prefix=$(mac_prefix) ssh_key_file=$(ssh_key_file) hostPrefix=$(hostPrefix) master_prefix=$(master_prefix) worker_prefix=$(worker_prefix)
	@_is=$$(grep '^image_source=' cluster.conf 2>/dev/null | cut -d= -f2 | sed 's/\#.*//' | awk '{print $$1}'); \
	 _is=$${_is:-mirror}; \
	 if [ "$$_is" != "direct" ] && [ "$$_is" != "proxy" ]; then \
	   ln -sfn ../$$_is mirror; \
	   [ -d ~/.aba/mirror/$$_is ] && ln -sfn ~/.aba/mirror/$$_is regcreds || rm -f regcreds; \
	 fi; \
	 if [ -f mirror/mirror.conf ]; then ln -fs mirror/mirror.conf; \
	 else rm -f mirror.conf && touch mirror.conf; fi

agentconf: install-config.yaml agent-config.yaml  ## Convenient step/target to only generate the agent config files, so they can be edited. 

# install-config.yaml is ALWAYS regenerated, even in primed bundles, because it
# contains registry-specific credentials (pull secret, rootCA, imageContentSources)
# that differ between the connected side (where the bundle was built) and the
# disconnected side (where the mirror runs). backup.sh --primed resolves the
# mirror.conf symlink to a real copy (newer timestamp), triggering this rebuild.
install-config.yaml: $(hv_conf_dep) cluster.conf mirror.conf .infra-dns | .cli  ## Create the install-config.yaml file based on the cluster.conf file.
	$(SCRIPTS)/verify-config.sh
	$(SCRIPTS)/create-install-config.sh

# .primed guard: when 'aba bundle --primed' bakes pre-built configs into the tar,
# it drops a .primed marker. $(wildcard .primed) expands to ".primed" if the file
# exists (empty dep list → no rebuild) or "" if absent (normal deps → rebuild).
# agent-config.yaml carries node-level config (IPs, MACs, topology) that does not
# depend on registry credentials, so it is safe to skip in primed mode.
# Remove .primed to force regeneration: rm .primed && aba agentconf
# macs.conf is a real Make dep so MAC edits rebuild agent-config.
agent-config.yaml: $(if $(wildcard .primed),,cluster.conf mirror.conf $(wildcard macs.conf)) | .init  ## Create the agent-based config file based on the cluster.conf file.
	$(if $(wildcard .primed),,$(SCRIPTS)/create-agent-config.sh)


.PHONY: verify
verify:  ## Extract cluster configuration details from the generated agent-based configuration files for manual verification only.
	@[ -f install-config.yaml ] && [ -f agent-config.yaml ] || { echo "[ABA] Config files not yet generated. Run 'aba agentconf' first."; exit 1; }
	$(SCRIPTS)/cluster-config.sh

.PHONY: preflight
preflight: install-config.yaml agent-config.yaml  ## Run pre-flight checks (DNS, NTP, IP conflicts).
	$(SCRIPTS)/preflight-check.sh

# Resolve VIPs: detect from DNS, auto-allocate (ABA-managed DNS), or back-fill.
# Must run before .infra-dns so VIPs are populated in cluster.conf.
.resolve-vips: cluster.conf | .cli
	@$(SCRIPTS)/resolve-vips.sh
	@touch .resolve-vips

# Auto-manage DNS records if ABA's dnsmasq is configured (tools/setup-dns.sh was run).
# Depends on .resolve-vips so VIPs are populated in cluster.conf before DNS creation.
.infra-dns: .resolve-vips
	@$(SCRIPTS)/infra-dns.sh add-cluster
	@touch .infra-dns

.preflight-done: install-config.yaml agent-config.yaml
	$(SCRIPTS)/preflight-check.sh
	@touch .preflight-done

# BM edit/review gate (no-op on vmw/kvm and when .primed)
.bm-config-reviewed: install-config.yaml agent-config.yaml
	$(SCRIPTS)/bm-ask-edit.sh
	@touch .bm-config-reviewed

# Ensure openshift-install binary exists (delegates to cli/Makefile if missing)
~/bin/openshift-install:
	$(MAKE) -sC ../cli openshift-install

.PHONY: iso
iso: iso-agent-based/agent.$(arch).iso ## Build the agent-based iso file in iso-agent-based dir.
	@printf '\033[0;32m[ABA] ISO ready: %s/iso-agent-based/agent.%s.iso\033[0m\n' "$(CURDIR)" "$(arch)"
	@echo "[ABA] Warning: The ISO contains certificates that expire 24 hours after creation."
	@echo "[ABA]          Boot your servers and complete the install within that window."
iso-agent-based/agent.$(arch).iso: .bm-config-reviewed .preflight-done .infra-dns ~/bin/openshift-install
	@bash -c 'source $(SCRIPTS)/include_all.sh && aba_progress "START|ci_iso"' || true
	$(SCRIPTS)/generate-image.sh
	@bash -c 'source $(SCRIPTS)/include_all.sh && aba_progress "DONE|ci_iso"' || true

# Bare metal: mount the ISO on each node in bmc.conf via its BMC (Redfish) and
# boot it, before waiting for the agent. bmc-boot.sh writes this stamp itself,
# also when bmc.conf lists no nodes (manual boot), and not when a node fails.
# Its fallback HTTP server stops when it exits, while the nodes still need the
# ISO, so an iso_url of a server that keeps serving it is required: in bmc.conf,
# set once the ISO is built (preflight HEADs it), or in the environment.
# On vmw/kvm this is a fast no-op (bmc-boot.sh with no bmc.conf).
.bm-bmc-boot-done: iso-agent-based/agent.$(arch).iso .vms-ready
	$(SCRIPTS)/bm-ask-boot.sh
	@if [ -z "$${iso_url:-}" ] && [ -f bmc.conf ] && grep -qE '^[[:space:]]*bmc_host_' bmc.conf \
	   && ! grep -qE '^[[:space:]]*iso_url=[^[:space:]#]' bmc.conf; then \
		echo "[ABA] Error: bmc.conf lists BMC nodes but sets no iso_url=." >&2; \
		echo "[ABA]        Serve $(CURDIR)/iso-agent-based/agent.$(arch).iso over HTTP, reachable" >&2; \
		echo "[ABA]        from the BMCs, until the installation completes, and set iso_url=<its URL>." >&2; \
		exit 1; \
	fi
	$(SCRIPTS)/bmc-boot.sh

# VM lifecycle stamps — no-op on bare-metal; use existing HV_* scripts on vmw/kvm.
# Single-shell recipes so empty HV_PREFIX does not fall through to -kill.sh etc.
.vms-stopped: iso-agent-based/agent.$(arch).iso
	@if [ -z "$(HV_PREFIX)" ]; then \
		touch .vms-stopped; \
	else \
		bash -c 'source $(SCRIPTS)/include_all.sh && aba_progress "START|ci_vms"' || true; \
		$(SCRIPTS)/$(HV_PREFIX)-kill.sh || true; \
		touch .vms-stopped; \
	fi

.PHONY: upload
upload: .iso-uploaded  ## Upload the ISO to the hypervisor platform.
.iso-uploaded: $(hv_conf_dep) .vms-stopped
	@if [ -z "$(HV_PREFIX)" ]; then \
		touch .iso-uploaded; \
	else \
		$(SCRIPTS)/$(HV_PREFIX)-upload.sh; \
		touch .iso-uploaded; \
	fi

.vms-ready: .init .iso-uploaded $(hv_conf_dep)
	@if [ -z "$(HV_PREFIX)" ]; then \
		touch .vms-ready; \
	else \
		$(SCRIPTS)/$(HV_PREFIX)-refresh.sh; \
		touch .vms-ready; \
		bash -c 'source $(SCRIPTS)/include_all.sh && aba_progress "DONE|ci_vms"' || true; \
	fi

.PHONY: refresh
refresh: $(hv_conf_dep) upload  ## Delete & re-create the VMs. Useful to redeploy a broken cluster.
	@if [ -z "$(HV_PREFIX)" ]; then echo "[ABA] refresh requires platform=vmw or platform=kvm"; exit 1; fi
	$(SCRIPTS)/$(HV_PREFIX)-refresh.sh workers=$(workers) masters=$(masters)

.install-complete: .bm-bmc-boot-done
	$(SCRIPTS)/monitor-install.sh
	@touch .install-complete

.PHONY: agent
agent:
	$(SCRIPTS)/wait-agent-up.sh

.PHONY: mon
mon:  ## Monitor for 'install complete' the agent-based installation of OpenShift.
	$(SCRIPTS)/monitor-install.sh
	@touch .install-complete

# Stamp file so bootstrap has real deps (not .PHONY). Chain runs config+ISO+VMs+agents, then monitor bootstrap.
.bootstrap-complete: $(BOOTSTRAP_PRE_DEPS)
	$(SCRIPTS)/monitor-bootstrap.sh
	@touch .bootstrap-complete

bootstrap: .bootstrap-complete  ## Monitor for 'bootstrap complete' (runs config+ISO+VM chain first when needed).

.PHONY: remove-cdrom
remove-cdrom: vmware.conf  ## Remove the cdrom device from all VMs (VMware only).
	$(SCRIPTS)/vmw-remove-cdrom-device.sh

.PHONY: vmw
vmw: vmware.conf ## Configure vCenter/ESXi API credentials in vmware.conf file.

.PHONY: kvm
kvm: kvm.conf ## Configure KVM/libvirt connection in kvm.conf file.

.PHONY: noask
noask:  ## Set 'ask' in aba.conf to 'false'.  ABA will assume all defaults and not prompt you for anything (allows for fully automated installations on vmw).
	@make -sC .. noask

.PHONY: ask
ask: ## Set 'ask' in aba.conf to 'true'  ABA will prompt you for certain actions. 
	@make -sC .. ask

# Only delete 'vmware.conf/regcreds/aba.conf' if they are symbolic links (credentials in ~/.aba/mirror/ are persistent)
.PHONY: clean
clean: ## Clean generated artifacts (not cluster.conf). Refuses if cluster is installed — use 'aba delete' first. Pass force=1 after delete.
	$(SCRIPTS)/cluster-clean.sh force=$(force)

.PHONY: reset
reset: # Clean up all files.  Only use if you know what you're doing! Only used to re-distribute the repository.
	@[ -x $(SCRIPTS)/reset-gate.sh ] && $(SCRIPTS)/reset-gate.sh $(force) || true
	@make clean force=1
	rm -f cluster.conf mirror.conf vmware.conf kvm.conf
	rm -f cluster.conf aba.conf                  vmware.conf kvm.conf      *.backup

