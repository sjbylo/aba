# File generated by ABA (github.com/sjbylo/aba)
kind: ImageSetConfiguration
apiVersion: mirror.openshift.io/v2alpha1
mirror:
  platform:
{%- if ARCH != 'amd64' and ARCH != 'x86_64' %}
    architectures:
    - {{ ARCH }}
{%- endif %}
    channels:
{%- if ocp_upgrade_to is defined and ocp_upgrade_to and ocp_upgrade_to != ocp_version %}
    - name: {{ ocp_channel }}-{{ tgt_major }}
      minVersion: {{ ocp_version }}
      maxVersion: {{ ocp_upgrade_to }}
      type: ocp
      shortestPath: true{%- if upgrade_path is defined and upgrade_path %}  # {{ upgrade_path }}{% endif %}
{%- else %}
    - name: {{ ocp_channel }}-{{ ocp_ver_major }}
      minVersion: {{ ocp_version }}
      maxVersion: {{ ocp_version }}
      type: ocp
#      shortestPath: true
{%- endif %}
    graph: true
{%- if additional_images is defined and additional_images %}
  additionalImages:
{%- for img in additional_images %}
  - name: {{ img.name }}  # {{ img.source }}
{%- endfor %}
{%- endif %}
{%- if has_operators == 'true' and operators_data %}
  operators:
{%- for cat in operators_data %}
  - catalog: {{ cat.catalog }}
{%- if cat.all %}
    packages:
{%- else %}
    packages:
{%- set current_group = {'name': ''} %}
{%- for pkg in cat.packages %}
{%- if pkg.group and pkg.group != current_group.name %}
{%- if current_group.update({'name': pkg.group}) %}{% endif %}
    # {{ pkg.group }} operators
{%- endif %}
    - name: {{ pkg.name }}{% if pkg.comment %}  # {{ pkg.comment }}{% endif %}

{%- if pkg.channel %}
      channels:
      - name: "{{ pkg.channel }}"
{%- endif %}
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- else %}
#  operators:
#  - catalog: registry.redhat.io/redhat/redhat-operator-index:v{{ tgt_major if (ocp_upgrade_to is defined and ocp_upgrade_to and ocp_upgrade_to != ocp_version) else ocp_ver_major }}
#    packages:
{%- endif %}
